# ==================== 网络配置 ====================
# 网络接口名称（根据你的操作系统和网络适配器填写）
# Windows 示例: Realtek 8852CE WiFi 6E PCI-E NIC
# Linux 示例: eth0, wlan0
# macOS 示例: en0, en1
NETWORK_INTERFACE=Realtek 8852CE WiFi 6E PCI-E NIC

# 扫描网段（CIDR格式）
# 常见格式: 192.168.1.0/24, 10.0.0.0/24, 172.16.0.0/24
SCAN_NETWORK=192.168.1.0/24

# ==================== 扫描配置 ====================
# 自动扫描间隔（秒），建议设置为10-30秒
SCAN_INTERVAL=10

# ARP扫描超时时间（秒）
SCAN_TIMEOUT=3